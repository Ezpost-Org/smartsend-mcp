{
  "name": "smartsend-mcp",
  "version": "0.1.0",
  "description": "MCP server for the SmartSend REST API — operate customers, WhatsApp templates, scheduled sends, lists and tags from any MCP client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ezpost-Org/smartsend-mcp.git"
  },
  "type": "module",
  "bin": {
    "smartsend-mcp": "./dist/index.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "smartsend",
    "whatsapp",
    "automation"
  ]
}
